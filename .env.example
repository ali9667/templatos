# Templatos environment variables
# Copy this file to .env.local for local development.
# All variables are optional: the site runs without any of them, but AI
# Studio needs OPENROUTER_API_KEY to actually generate text.

# ---------------------------------------------------------------------------
# AI Studio (OpenRouter)
# ---------------------------------------------------------------------------
# Server-side only — never exposed to the browser. Get a key at
# https://openrouter.ai/keys. Without it, /api/generate returns a clear
# "not configured" error instead of a fake result.
OPENROUTER_API_KEY=

# Optional. Defaults to "openrouter/free" if unset.
OPENROUTER_MODEL=openrouter/free

# Optional. Sent as the HTTP-Referer / X-Title headers on OpenRouter requests
# (used for OpenRouter's own request attribution, not required to work).
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Templatos AI Studio

# ---------------------------------------------------------------------------
# Rate limiting for /api/generate
# ---------------------------------------------------------------------------
# Optional. If both Upstash variables are set, rate limiting is shared across
# serverless instances via Upstash Redis (recommended on Vercel). If unset,
# Templatos falls back to a simple in-memory limiter, which is fine for local
# development and single-instance deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Defaults shown below: 8 requests per IP per 60-second window.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=8

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Optional for local development (falls back to http://localhost:3000). Set
# this in production so metadata, the sitemap, robots.txt and the registry
# URLs point at your real domain instead of localhost.
NEXT_PUBLIC_SITE_URL=
